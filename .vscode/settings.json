{
  // Point VS Code directly to the uv-generated virtual environment
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvInTerminal": true,
  "python.workspaceSearchPaths": ["${workspaceFolder}/.venv"],

  // Force VS Code to use the official Ruff extension for linting and formatting
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  // 3. Configure testing to point directly to the uv environment's pytest
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingModuleSource": "none"
  },
  // 4. Hide temporary git/uv artifacts from your file explorer to keep it clean
  "files.exclude": {
    // "**/.pytest_cache": true,
    "**/__pycache__": true,
    "**.egg-info": true,
    // "**/.ruff_cache": true,
    "**/.venv": true,
    // "**/uv.lock": true
  }

}
